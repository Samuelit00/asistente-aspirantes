#Clave de acceso proporcionada por el BotFather de telegram para reconocer la propiedad del bot y poder enviar mensajes a los usuarios
TELEGRAM_BOT_TOKEN=

#Clave de acceso a la API de LLM para poder utilizar el modelo de lenguaje, se crea en el panel del proveedor del modelo
LLM_API_KEY=

#Linea de conexión a la base de datos PostgreSQL para almacenar información de interacciones y un hash anonimo 
#postgresql://usuario:contraseña@host:puerto/nombre_base_de_datos
DATABASE_URL=

#Llave generada, por la libreria de python secrets para verificar la autenticidad de los mensajes entrantes del webhook de Telegram
TELEGRAM_WEBHOOK_SECRET=
